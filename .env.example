# Copy to .env (or export these) before running. Everything is optional for local use.

# Database: Postgres in production (DATABASE_URL or POSTGRES_URL). Unset = local SQLite file
# DATABASE_URL=postgresql://user:pass@localhost:5432/pipsqueak

# Flask session signing key. Set a long random value anywhere real users log in.
SESSION_SECRET=change-me

# Optional: enables the one-paragraph AI insights on recommendations
# OPENAI_API_KEY=

# Pump research
# SEC asks for a contact in the User-Agent: "Your Name you@example.com"
SEC_USER_AGENT=
# Optional: Polygon.io key for delisted tickers and news history
# POLYGON_API_KEY=
# Where the web app reads pump research output (default: ./pump_data; /tmp/pump_data on Vercel)
# PUMP_DATA_DIR=pump_data
# Download that data at runtime from a tarball URL (default on Vercel: this repo's pump-data branch)
# PUMP_DATA_URL=

# Skip the background market scanner threads (tests, scripts, low-resource machines)
# DISABLE_BACKGROUND_SCANNER=1

# Folder for caches and other runtime files (default: current folder; /tmp on Vercel)
# APP_WRITABLE_DIR=
